{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "outDir": "build",
    "rootDir": "src",
    "declaration": true,
    "strictNullChecks": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "exclude": [
    "tests",
    "./build/**/*"
  ]
}
