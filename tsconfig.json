{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "outDir": "build",
    "rootDir": "src",
    "declaration": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
  },
  "exclude": [
    "tests",
    "./build/**/*"
  ]
}
